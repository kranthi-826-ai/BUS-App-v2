# Mobile public configuration (never put secrets in EXPO_PUBLIC_* variables)
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080/api/v1
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Backend local development
DB_URL=jdbc:mysql://localhost:3306/smart_bus?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=smart_bus_app
DB_PASSWORD=replace_me
JWT_SECRET_BASE64=replace_with_at_least_32_random_bytes_base64
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
ALLOWED_ORIGINS=http://localhost:8081
LOCATION_RETENTION_DAYS=30
ARRIVAL_RADIUS_METERS=500
LOCATION_STALE_SECONDS=45

# Push notification integration; configure only when the milestone begins
EXPO_ACCESS_TOKEN=

# Future feature; must remain false in MVP
FEATURE_FACE_ATTENDANCE=false
AI_SERVICE_BASE_URL=http://localhost:5000
# Optional authorized college tracking provider. Keep disabled until the college/provider supplies an API contract.
EXTERNAL_TRACKING_ENABLED=false
EXTERNAL_TRACKING_PROVIDER=none
EXTERNAL_TRACKING_BASE_URL=
EXTERNAL_TRACKING_API_TOKEN=
EXTERNAL_TRACKING_POLL_SECONDS=30
